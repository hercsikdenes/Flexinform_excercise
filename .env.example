# Local Docker Compose defaults. Replace the password outside development.
POSTGRES_DB=car_service
POSTGRES_USER=car_service
POSTGRES_PASSWORD=car_service_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

SERVER_PORT=8080
SHUTDOWN_TIMEOUT=10s
DATA_DIR=/app/data
MIGRATIONS_DIR=/app/migrations

# Optional explicit override. Compose otherwise builds DATABASE_DSN from the
# PostgreSQL values above.
# DATABASE_DSN=postgres://car_service:car_service_dev_password@db:5432/car_service?sslmode=disable
